/**
 * Memory of 16384 16-bit registers:
 * Upper 2 bits select the RAM4K bank; lower 12 bits address within the bank.
 */
CHIP RAM16K {
    IN in[16], load, address[14];
    OUT out[16];

    PARTS:
    DMux4Way(in=load, sel=address[12..13], a=l0, b=l1, c=l2, d=l3);

    RAM4K(in=in, load=l0, address=address[0..11], out=b0);
    RAM4K(in=in, load=l1, address=address[0..11], out=b1);
    RAM4K(in=in, load=l2, address=address[0..11], out=b2);
    RAM4K(in=in, load=l3, address=address[0..11], out=b3);

    Mux4Way16(a=b0, b=b1, c=b2, d=b3, sel=address[12..13], out=out);
}
