/**
 * Memory of 4096 16-bit registers:
 * Upper 3 bits select the RAM512 bank; lower 9 bits address within the bank.
 */
CHIP RAM4K {
    IN in[16], load, address[12];
    OUT out[16];

    PARTS:
    DMux8Way(in=load, sel=address[9..11], a=l0, b=l1, c=l2, d=l3, e=l4, f=l5, g=l6, h=l7);

    RAM512(in=in, load=l0, address=address[0..8], out=b0);
    RAM512(in=in, load=l1, address=address[0..8], out=b1);
    RAM512(in=in, load=l2, address=address[0..8], out=b2);
    RAM512(in=in, load=l3, address=address[0..8], out=b3);
    RAM512(in=in, load=l4, address=address[0..8], out=b4);
    RAM512(in=in, load=l5, address=address[0..8], out=b5);
    RAM512(in=in, load=l6, address=address[0..8], out=b6);
    RAM512(in=in, load=l7, address=address[0..8], out=b7);

    Mux8Way16(a=b0, b=b1, c=b2, d=b3, e=b4, f=b5, g=b6, h=b7, sel=address[9..11], out=out);
}
