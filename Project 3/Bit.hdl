/**
 * 1-bit register (Bit):
 * if load(t) == 1 then out(t+1) = in(t), else out(t+1) = out(t)
 */
CHIP Bit {
    IN in, load;
    OUT out;

    PARTS:
    Mux(a=storedBit, b=in, sel=load, out=nextBit);
    DFF(in=nextBit, out=storedBit, out=out);
}
