/**
 * Exclusive-or gate:
 * if ((a and Not(b)) or (Not(a) and b)) out = 1, else out = 0
 */
CHIP Xor {
    IN a, b;
    OUT out;

    PARTS:
    // Minimal 4-Nand realization of XOR.
    Nand(a=a, b=b, out=nandAB);
    Nand(a=a, b=nandAB, out=aBranch);
    Nand(a=b, b=nandAB, out=bBranch);
    Nand(a=aBranch, b=bBranch, out=out);
}
